# Environment variables for Probe MVP

# OpenAI-compatible interviewer (required for live chat)
OPENAI_API_KEY=
# Optional override; default gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Realtime transcription (voice STT) — uses OPENAI_API_KEY server-side only.
# Browser POSTs WebRTC SDP to POST /api/realtime/transcribe; the server proxies to
# OpenAI /v1/realtime/calls (permanent key never reaches the browser).
# Optional: silence (ms) before the browser commits a spoken turn (default 1400).
# OPENAI_REALTIME_SILENCE_MS=1400

# OpenAI TTS (interviewer speech via POST /api/tts/speak) — uses OPENAI_API_KEY
# Optional voice (default cedar). Newest/most natural: cedar, marin.
# Also available: ash, ballad, sage, verse, coral, alloy, echo, fable, nova, shimmer.
# `ash` is the alternative for a deeper, slower read.
OPENAI_TTS_VOICE=cedar
# Optional model (default gpt-4o-mini-tts; falls back to tts-1 if unavailable).
# tts-1 ignores the delivery instructions, so a fallback response is labelled with the
# X-TTS-Fallback header instead of downgrading silently.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional override for the delivery direction (tone / pacing / intonation) sent to
# gpt-4o-mini-tts. Unset uses the calm senior-engineer interviewer persona in
# src/lib/voice/tts/delivery.ts. Has no effect on tts-1.
# OPENAI_TTS_INSTRUCTIONS=
# Optional audio format (default mp3). opus is ~40% smaller but Safari cannot play
# Ogg Opus from a blob URL, so mp3 is the safe default.
# OPENAI_TTS_FORMAT=mp3
# Optional playback speed 0.25–4.0. Leave unset: pacing is steered through the delivery
# instructions, whereas `speed` time-scales the audio and flattens prosody.
# OPENAI_TTS_SPEED=

# --- Speech provider -------------------------------------------------------
# `openai` (default) or `cartesia`. Cartesia Sonic is a conversational speech
# model: prosody comes from the model, so it needs no delivery instructions and
# reaches first audio far faster than gpt-4o-mini-tts. The OPENAI_TTS_* vars
# above apply only to the OpenAI path.
# TTS_PROVIDER=cartesia

# Required when TTS_PROVIDER=cartesia. Server-only; never expose to the browser.
# CARTESIA_API_KEY=

# Required when TTS_PROVIDER=cartesia — pick one at https://play.cartesia.ai/voices
# CARTESIA_VOICE_ID=

# CARTESIA_MODEL=sonic-3.6
# CARTESIA_FORMAT=mp3
# CARTESIA_LANGUAGE=en
