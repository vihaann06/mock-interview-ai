# Environment variables for Probe MVP

# OpenAI-compatible interviewer (required for live chat)
OPENAI_API_KEY=
# Optional override; default gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Realtime transcription (voice STT) — uses OPENAI_API_KEY server-side only.
# Browser never sees the permanent key; SDP is proxied via POST /api/realtime/transcribe.
# Optional silence window (ms) for server VAD turn detection (default 1400).
# OPENAI_REALTIME_SILENCE_MS=1400

# OpenAI TTS (interviewer speech via POST /api/tts/speak) — uses OPENAI_API_KEY
# Optional voice (default alloy). Examples: alloy, ash, coral, echo, sage, shimmer
OPENAI_TTS_VOICE=alloy
# Optional model (default gpt-4o-mini-tts; falls back to tts-1 if unavailable)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
